# Artefactos generados por msfvenom
payloads/*
!payloads/.gitkeep
rc_files/*
!rc_files/.gitkeep

# Metadatos generados por el despliegue Docker
lab/manifests/*.json
!lab/manifests/.gitkeep

# Logs y datos locales de ejecución
*.log
*.session
*.dump

# Credenciales y configuración local
.env
.env.*
*.pem
*.key
*.p12
*.pfx

# Cachés y artefactos de Python
__pycache__/
*.py[cod]
*$py.class

# Entornos virtuales
.venv/
venv/
env/

# SO/IDE
.DS_Store
.vscode/
.idea/
